page{
  background-color: #f0f4f8;
}
.pic{
  width: 100%;
  display: block;
}

/* 通用块 */
.block{
  margin: 24rpx 30rpx;
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 51, 102, 0.08);
}
/* 淡蓝色块（基本信息、座右铭） */
.block-blue{
  background-color: #e6f0fa;
  border-left: 8rpx solid #003366;
}
.block-title{
  font-size: 34rpx;
  font-weight: bold;
  color: #003366;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  border-bottom: 2rpx solid #c9d8e8;
}

/* 基本信息行 */
.info-line{
  font-size: 30rpx;
  line-height: 1.9;
  color: #1a2432;
}

/* 简介正文 */
.body{
  font-size: 30rpx;
  line-height: 1.75;
  color: #333;
  padding-bottom: 18rpx;
}

/* 兴趣特长表格 */
.table-wrap{
  margin-top: 10rpx;
  border: 1rpx #c9d8e8 solid;
  border-radius: 8rpx;
  overflow: hidden;
}
.table-row{
  display: flex;
}
.table-cell{
  flex: 1;
  padding: 24rpx 10rpx;
  border-right: 1rpx #c9d8e8 solid;
  border-bottom: 1rpx #c9d8e8 solid;
  text-align: center;
  font-size: 28rpx;
  color: #1a2432;
  background-color: #f7fafd;
}
.table-row:last-child .table-cell{
  border-bottom: none;
}
.table-cell:last-child{
  border-right: none;
}

/* 座右铭 */
.motto{
  font-size: 32rpx;
  line-height: 1.8;
  color: #003366;
  font-weight: 500;
  text-align: center;
  letter-spacing: 2rpx;
}
