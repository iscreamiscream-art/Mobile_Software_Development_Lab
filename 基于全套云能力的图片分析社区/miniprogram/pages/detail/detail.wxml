<view wx:if="{{post}}" class="page">
  <!-- 作者条 -->
  <view class="card-head">
    <navigator class="card-avatar-wrap" url="/pages/homepage/homepage?id={{post._openid}}" hover-class="none">
      <image wx:if="{{post.avatarUrl}}" class="card-avatar" src="{{post.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="card-avatar card-avatar-txt">{{post.nickName ? post.nickName[0] : '微'}}</view>
    </navigator>
    <view class="card-user">
      <view class="card-nickname">{{post.nickName || '微信用户'}}</view>
      <view wx:if="{{post.region}}" class="card-region">{{post.region}}</view>
    </view>
  </view>

  <!-- 正文 -->
  <view wx:if="{{post.content}}" class="detail-content">{{post.content}}</view>

  <!-- 图片九宫格(较大) -->
  <view wx:if="{{post.images && post.images.length}}" class="detail-photo {{post.single ? 'single' : ''}}">
    <image
      wx:for="{{post.images}}"
      wx:for-item="img"
      wx:key="*this"
      class="d-img"
      src="{{img}}"
      mode="widthFix"
      data-url="{{img}}"
      bindtap="preview"
    ></image>
  </view>

  <view class="detail-time">{{post.addDate}}</view>

  <!-- 操作条 -->
  <view class="action-bar detail-actions">
    <button class="action-item like {{post.liked ? 'on' : ''}}" bindtap="onLike" hover-class="none">
      <text class="action-ic">{{post.liked ? '❤' : '♡'}}</text><text>{{post.likeCount}}</text>
    </button>
    <button class="action-item {{post.faved ? 'on' : ''}}" bindtap="onFav" hover-class="none">
      <text class="action-ic">{{post.faved ? '★' : '☆'}}</text><text>{{post.favCount}}</text>
    </button>
    <button wx:if="{{isLogin}}" class="action-item" open-type="share" bindtap="onShare" hover-class="none">
      <text class="action-ic">↗</text><text>{{post.shareCount}}</text>
    </button>
    <button wx:else class="action-item" bindtap="onShare" hover-class="none">
      <text class="action-ic">↗</text><text>{{post.shareCount}}</text>
    </button>
  </view>

  <view class="detail-btns">
    <button class="primary-btn" bindtap="onDownload">下载图片</button>
  </view>
</view>

<view wx:elif="{{!loading}}" class="empty">帖子不存在或已删除</view>
