.page {
  padding: 24rpx;
}

/* 顶部信息 */
.publish-head {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx 20rpx;
}
.p-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e5e6eb;
  flex-shrink: 0;
}
.p-avatar-txt {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1296db;
  font-size: 36rpx;
  font-weight: 600;
}
.p-name {
  flex: 1;
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.p-login {
  color: #1296db;
  font-size: 28rpx;
}

/* 正文 */
.content-input {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
}
.content-ph {
  color: #bbb;
}

/* 图片网格 */
.img-box {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.img-cell {
  position: relative;
  width: calc((100% - 48rpx) / 3);
  height: 210rpx;
  margin: 0 24rpx 24rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
}
.img-cell:nth-child(3n) {
  margin-right: 0;
}
.sel-img {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 36rpx;
  line-height: 40rpx;
  text-align: center;
}
.img-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx dashed #c0d8ec;
}
.add-plus {
  font-size: 70rpx;
  color: #1296db;
  font-weight: 300;
}
.img-count {
  font-size: 24rpx;
  color: #999;
}

.submit-wrap {
  margin-top: 40rpx;
}
.submit-btn {
  width: 100%;
}
